# Copy these names into an operator-managed environment or secure secret store.
# Values are passed explicitly or sourced by the operator and are never committed.
BUNDLE_ROOT=
BIND_HOST=
PORT=8000
STATE_FILE=
AUDIO_PROXY_URL=
# Comma-separated DNS host names, for example: media.example.com,cdn.example.com
AUDIO_ALLOWED_HOSTS=
AUDIO_TEMP_ROOT=
AUDIO_BUDGET_SECONDS=20
MAX_CONCURRENT_AUDIO=4
EMOTION_SEMANTIC_RERANKER_URL=
SEMANTIC_RERANKER_TIMEOUT_SECONDS=3
SEMANTIC_RERANKER_MIN_GAP=0.10
SEMANTIC_RERANKER_CANDIDATE_COUNT=7
EMOTION_RUBRIC_PATH=
# Optional append-only JSONL trace path for hard-case mining; keep outside the bundle.
EMOTION_TRACE_PATH=
